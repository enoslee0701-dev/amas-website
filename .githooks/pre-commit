#!/bin/sh
# auto cache-bust on every commit:
#   1. bump.py 先 GUARD（写入前）：候选 HTML 若有未暂存改动或未跟踪，整体拒绝并列出路径
#   2. 安全则打戳，并只暂存 bump.py 自己报告改动过的那些文件
#   3. 用 --from-index 校验**进入提交的内容**是否满足缓存戳契约，不满足即中止提交
#
# ── 为什么 GUARD 必须在 bump.py 内部、且在写入之前 ──────────────────
# 本 hook 会把打戳后的文件自动暂存。若某个 HTML 处于「部分暂存」状态
# （已 add 意图变更，之后又写了未暂存的私稿），对整文件暂存会把私稿一并提交。
# 未跟踪的 HTML 同理：打戳后被暂存，等于把作者没打算提交的新文件带进提交。
# 所以检查必须发生在任何写入之前，而不是事后补救。
#
# ── 对「不得损坏无关内容」的处理 ─────────────────────────────────────
# 本 hook 只做上面三件事，**不执行** reset / checkout / stash / clean / add -A。
# 拒绝时不动工作区、不动暂存区，只打印确切路径，由作者自行处置。
# 打戳成功后被暂存的那些文件，是它们本就该有的更新，不是损坏。
#
# ── 输出为什么是英文 ─────────────────────────────────────────────────
# hook 的 stderr 会流经 git、Windows 控制台代码页与外部采集脚本；
# 非 ASCII 在 GBK 环境下会让整条流解码失败，拿不到确切路径就等于没报。

set -u

# ── Python 解释器：按名字找，不写死 ─────────────────────────────────
# 原先直接调 `python`。macOS 上**没有** `python` 这个命令（只有 `python3`），
# 于是 hook 在 Mac 检出上每次都以 127 失败，整个缓存戳契约等于没设防。
# 反过来在 Git for Windows 里 `python3` 又常常不存在。
# 所以按顺序探一遍，取第一个能用的；两个都没有就明说，不要静默跳过校验。
PY=""
for c in python3 python py; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  echo "pre-commit: no Python interpreter found (tried python3, python, py); aborted." >&2
  echo "  This hook enforces the cache-bust contract and will not silently skip it." >&2
  exit 1
fi

# ── 1+2. GUARD 与打戳（bump.py 内部保证顺序）─────────────────────────
if ! STAMPED=$("$PY" scripts/bump.py 2>&1); then
  echo "pre-commit: aborted." >&2
  printf '%s\n' "$STAMPED" >&2
  exit 1
fi

if ! printf '%s\n' "$STAMPED" | sed -n 's/^stamped //p' | tr '\n' '\0' | xargs -0 -r git add --; then
  echo "pre-commit: failed to stage stamped files; aborted." >&2
  exit 1
fi

# ── 3. 校验进入提交的内容 ───────────────────────────────────────────
if ! "$PY" scripts/check-cache-bust.py --from-index; then
  echo "" >&2
  echo "pre-commit: cache-bust contract failed; commit aborted." >&2
  echo "  The verdict above is about the INDEX, i.e. what would actually be committed." >&2
  echo "  This hook performed no undo-style operation." >&2
  echo "  Recheck:        python3 scripts/check-cache-bust.py --from-index" >&2
  echo "  Contract cases: python3 scripts/test-cache-bust-contract.py" >&2
  echo "  Gate cases:     python3 scripts/test-hook-gate.py" >&2
  exit 1
fi

exit 0
